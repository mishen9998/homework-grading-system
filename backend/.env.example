# 复制为 backend/.env 后按实际 MySQL 信息修改
# 密码中的 @、:、/、# 等特殊字符需要先做 URL 编码
DATABASE_URL=mysql+pymysql://homework_user:change-me@127.0.0.1:3306/homework?charset=utf8mb4

# 应用密钥
SECRET_KEY=change-this-secret-key
JWT_SECRET_KEY=change-this-jwt-secret

# AI（可选）
DEEPSEEK_API_KEY=

# 可选：本地多语言 SentenceTransformers 模型名称或本地目录。
# 留空时使用无模型依赖的本地混合向量检索。
LOCAL_EMBEDDING_MODEL=

# 可选扩展：留空时使用进程内缓存和 MySQL 向量候选集。
# 生产环境建议把 Redis 和 Qdrant 部署在校内网络，不开放公网端口。
REDIS_URL=
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=school_knowledge

# 每个账号每分钟上限；0 表示不限制。
KNOWLEDGE_QUERY_RATE_LIMIT=60
KNOWLEDGE_AGENT_RATE_LIMIT=60
DEEPSEEK_QUERY_RATE_LIMIT=10
KNOWLEDGE_CACHE_TTL=120
KNOWLEDGE_LEXICAL_CANDIDATES=300
KNOWLEDGE_VECTOR_CANDIDATES=80
KNOWLEDGE_FALLBACK_CANDIDATES=1500
KNOWLEDGE_MYSQL_FULLTEXT=true
KNOWLEDGE_CHUNK_CANDIDATES=600
KNOWLEDGE_NEURAL_MIN_SCORE=0.50
QDRANT_CHUNK_COLLECTION=school_knowledge_chunks

# 完成 数据库/upgrade.py 初始化/升级后设为 false。
AUTO_CREATE_TABLES=false

# MySQL 连接池（每个后端进程）。
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=15

# 前端地址
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
